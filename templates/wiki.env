# Settings and secrets of one wiki. scripts/new-wiki.sh writes it from templates/wiki.env; it stays
# in wikis/<name>/.env (mode 600, never in git). Changes take effect with `docker compose up -d`.
# Values with spaces or special characters need quotes ('...' is taken literally).

# Compose project name = the wiki's folder name; it also names the volumes (<name>_db-data, ...).
COMPOSE_PROJECT_NAME=wiki

# Public URL of the wiki, no trailing slash. https:// forces HTTPS and secure cookies.
WIKI_SERVER=http://localhost:8081
# Host name for the Traefik rule (the host of WIKI_SERVER)
WIKI_HOST=localhost
WIKI_NAME='My Wiki'
# Content language; fixed at install
WIKI_LANG=en
# Time zone pages are shown in (and of log timestamps), and the default date format (dmy, mdy, ymd, ISO 8601)
WIKI_TIMEZONE=UTC
WIKI_DATE_FORMAT=dmy
# Default Vector theme for everyone: os (follows the system), day or night
WIKI_DEFAULT_THEME=os
# roboto (self-hosted Roboto, from the image) or default (Vector's own fonts)
WIKI_FONT=roboto
# Page URLs: /wiki (short URLs, /wiki/<page>) or /index.php (/index.php/<page>). Both forms, and
# /index.php?title=<page>, are always understood, so switching breaks no links.
WIKI_ARTICLE_PATH=/wiki

# Image: new-wiki.sh defaults to the published image ghcr.io/<owner>/<repo> of the clone's GitHub
# origin (pulled); a plain name such as mediawiki-smw is built locally from the repository instead. Watchtower follows the floating tag (1.46-smw7.3: MediaWiki 1.46.x and
# SMW 7.3.x patches). Pin an immutable tag such as 1.46.2-smw7.3.1-r3.42 to hold a version (rollback).
WIKI_IMAGE=mediawiki-smw
WIKI_TAG=1.46-smw7.3

# Host port (unused behind Traefik) and the address it is published on: 127.0.0.1 (loopback only)
# or 0.0.0.0 (all interfaces)
WIKI_PORT=8081
WIKI_BIND=127.0.0.1

DB_NAME=wiki
DB_USER=wiki
DB_PASSWORD=
DB_ROOT_PASSWORD=

# openssl rand -hex 32
WIKI_SECRET_KEY=
WIKI_UPGRADE_KEY=
# Encrypts 2FA secrets (OATHAuth). Never change it once anyone has enrolled; keep it when moving the wiki.
WIKI_OATH_KEY=

# First administrator; used only by the scripts (install, smoke test), never passed to the wiki
ADMIN_USER=Admin
ADMIN_PASSWORD=

# 1 shows PHP exception details on error pages (local debugging only)
WIKI_DEBUG=0
# Seconds the job loop sleeps between runJobs polls (lower = faster SMW query/template propagation)
JOB_RUNNER_INTERVAL=30

# Optional SMTP (mail stays off unless SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
WIKI_EMAIL_FROM=

# Traefik (production; see the Traefik block in compose.yaml): the external network Traefik watches,
# its entrypoint and certificate resolver
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=
# Proxies whose X-Forwarded-For is trusted: IPs/CIDRs, or "private" (10/8, 172.16/12, 192.168/16).
# Empty: none (right without a proxy). Behind Traefik set the Traefik network's subnet or "private".
# Used by MediaWiki (client IPs in RecentChanges, blocks) and by the Apache access log (docker compose
# logs wiki). Subnet: docker network inspect web --format '{{(index .IPAM.Config 0).Subnet}}'
# An invalid entry stops the container with an error.
WIKI_TRUSTED_PROXIES=
